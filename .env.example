# Copy to .env and fill in. Never commit .env or paste keys into chat.

# --- Models. Add at least one key. ---
# Stay on Groq's free plan: Groq bills by account plan, which code can't check.
GROQ_API_KEY=
OPENROUTER_API_KEY=

# Order to try providers. It's also a hard limit: "groq" alone means nothing is
# ever sent to OpenRouter. Use that for real customer messages.
LLM_PROVIDERS=groq,openrouter

# OpenRouter models with these prefixes are cycled first; other free models are
# the failover. Leave empty to cycle through every free model equally.
PREFERRED_MODEL_PREFIXES=nvidia/

# Most models tried per provider for one agent step.
MAX_MODEL_ATTEMPTS=4
# on = every outgoing AI reply also gets an AI review (3 requests per reply).
# off = code rules only (2 requests per reply). Code rules always run.
GUARD_LLM=on

# --- Business ---
SALON_PROFILE=config/salon.example.json
DB_PATH=rebook.db

# --- WhatsApp Cloud API. Only needed for real sending and the webhook. ---
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
# Check Meta's docs for the current version before going live.
WHATSAPP_GRAPH_VERSION=v23.0
PORT=3000
